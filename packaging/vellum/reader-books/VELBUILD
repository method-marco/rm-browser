maintainer="mr_marco <marco_meier2210@hotmail.com>"
pkgname=reader-books
pkgver=0.1.0
pkgrel=0
upstream_author="method-marco"
category="apps"
pkgdesc="EPUB reader for AppLoad: the books in the library folder Library, paged text, KOReader progress sync (kosync)"
url="https://github.com/$upstream_author/rm-browser"
arch="aarch64"
license="MIT AND OFL-1.1"
depends="appload remarkable-os>=3.29 remarkable-os<3.30"
readmeurl="https://raw.githubusercontent.com/$upstream_author/rm-browser/v$pkgver/README.md"

source="
$pkgname-$pkgver.tar.gz::https://github.com/$upstream_author/rm-browser/archive/refs/tags/v$pkgver.tar.gz
"
builddir="$srcdir/rm-browser-$pkgver"

image="ghcr.io/toltec-dev/golang:v4.0"

build() {
	apt-get update
	apt-get install -y --no-install-recommends qt6-base-dev

	# go.mod needs Go 1.25 (os.Root file functions); the image has 1.24
	cd "$builddir"/backend
	GOTOOLCHAIN=auto GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build \
		-buildvcs=false -trimpath -ldflags="-s -w -X main.version=$pkgver" \
		-o "$builddir"/build/backend/entry ./books

	cd "$builddir"/app
	/usr/lib/qt6/libexec/rcc --binary \
		-o "$builddir"/build/resources.rcc books.qrc
}

package() {
	_appdir="$pkgdir"/home/root/xovi/exthome/appload/rm-books

	cd "$builddir"
	install -Dm755 build/backend/entry "$_appdir"/backend/entry
	install -Dm644 build/resources.rcc "$_appdir"/resources.rcc
	install -Dm644 app/books/manifest.json "$_appdir"/manifest.json
	install -Dm644 app/books/icon.png "$_appdir"/icon.png

	install -Dm644 LICENSE \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	# the bundled fonts (SIL Open Font License)
	for _f in backend/fonts/OFL-*.txt; do
		install -Dm644 "$_f" "$pkgdir"/home/root/.vellum/licenses/$pkgname/"$(basename "$_f")"
	done
	# the hyphenation patterns built into the backend (hyph-utf8)
	install -Dm644 backend/books/hyph/NOTICES.txt \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/HYPHENATION-NOTICES.txt
	echo "$url" > "$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postdeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		# settings, reading positions and the sync login
		rm -rf /home/root/.config/rm-books
		# converted pictures
		rm -rf /home/root/.cache/rm-books
		rm -rf /home/root/.cache/rm-books-jail
	fi
}

sha512sums='
'
